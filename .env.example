# Copy to .env and fill in. sqlvec loads .env automatically and never
# overrides variables already set in your shell.

# Connection string (mssql-python / ODBC style). Local docker compose default:
SQLVEC_CONN=Server=localhost,1433;Database=sqlvec;UID=sa;PWD=Sqlvec_Local_Dev_2026!;Encrypt=yes;TrustServerCertificate=yes
# Azure SQL Database (scripts/up.sh writes this into .env.azure for you):
# SQLVEC_CONN=Server=tcp:<server>.database.windows.net,1433;Database=sqlvec;UID=sqlvecadmin;PWD=<password>;Encrypt=yes;TrustServerCertificate=no

# Embeddings: "hash" (free, offline, demo quality) or "azure" (Azure OpenAI).
SQLVEC_EMBED_PROVIDER=hash
# Must match the VECTOR(n) column. float32 VECTOR allows up to 1998.
# text-embedding-3-small is 1536 natively.
SQLVEC_EMBED_DIMS=1536

# Chunking, in characters.
SQLVEC_CHUNK_SIZE=1000
SQLVEC_CHUNK_OVERLAP=150

# Azure OpenAI, only for SQLVEC_EMBED_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Integration tests only (sqlvec tables in this database get dropped!):
# SQLVEC_TEST_CONN=Server=localhost,1433;Database=sqlvec_test;UID=sa;PWD=Sqlvec_Local_Dev_2026!;Encrypt=yes;TrustServerCertificate=yes
